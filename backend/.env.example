# Gebeta Food Delivery — backend environment
# Copy to .env and change JWT_SECRET before running anything.

# Core
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/gebeta
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d
# Comma-separated list, or * to allow any origin during development.
CORS_ORIGIN=*

# Realtime dispatch
OFFER_TIMEOUT_MS=30000
OFFER_RETRY_MS=15000
COURIER_LOAD_CAP=2
ASSIGNMENT_RADIUS_START_M=3000
ASSIGNMENT_RADIUS_STEP_M=2500
ASSIGNMENT_MAX_ATTEMPTS=6
WATCHDOG_INTERVAL_MS=20000
ORPHAN_AFTER_MS=60000
LOCATION_THROTTLE_MS=10000
PICKUP_TOLERANCE_M=400
DROPOFF_TOLERANCE_M=300

# Money, always integer cents
DELIVERY_FEE_CENTS=15000
SERVICE_RATE_BPS=500
COURIER_FEE_CENTS=12000
MIN_ORDER_CENTS=10000

# Payments
# mock = local stand-in (default). stripe activates automatically once STRIPE_SECRET_KEY is set.
PAYMENT_GATEWAY=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
