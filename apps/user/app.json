{
  "expo": {
    "name": "Gebeta User",
    "slug": "gebeta-user",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gebetauser",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gebeta.user"
    },
    "android": {
      "package": "com.gebeta.user"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "gebetauser://"
        }
      ],
      "expo-status-bar",
      "expo-font"
    ]
  }
}
