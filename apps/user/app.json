{
  "expo": {
    "name": "Gebeta User",
    "slug": "gebeta-user",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gebetauser",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": { "backgroundColor": "#ffffff", "resizeMode": "contain" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.gebeta.user" },
    "android": { "package": "com.gebeta.user", "edgeToEdgeEnabled": false },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": [["expo-router", { "origin": "gebetauser://" }]]
  }
}
