# Gebeta User — build-time client configuration
# Copy to .env only if the app should not use the API it derives automatically.

# Leave unset to reach the backend through Metro's own host address, which is what
# you want while developing: a phone on the same Wi-Fi finds the laptop on port 4000.
# Set it to the deployed URL to make the app use the hosted backend instead.
EXPO_PUBLIC_API_URL=https://gebeta-api-tcv4.onrender.com

# Google Maps keys for the live courier map. These ship inside the app bundle, so
# they are browser/mobile keys with an API restriction — never a secret key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
